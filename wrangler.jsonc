{
  // Cloudflare Workers, static assets only: no Worker code, no bindings.
  // `npm run deploy:cloudflare` builds and deploys. Rename before deploying.
  "$schema": "node_modules/wrangler/config-schema.json",
  // Bukidnon: one Worker, the public portal, built from `main` by Workers Builds with
  // `npx wrangler deploy`. See docs/architecture.md#deploy.
  "name": "budget-bukidnon",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Client-side routes (/districts, /projects/...) serve index.html.
    "not_found_handling": "single-page-application"
  },
  // The public portal's address. Each deploy attaches this Custom Domain to the Worker,
  // taking it from any other Worker that has it, and the workers.dev address stays off,
  // so the domain is the only public address.
  "routes": [{ "pattern": "budget.betterbukidnon.org", "custom_domain": true }],
  "workers_dev": false,
  // Every other branch, `develop` included, gets a Preview URL on workers.dev from
  // Workers Builds (`npx wrangler preview`). That is the development site; production
  // stays off workers.dev. `wrangler preview` requires the `previews` block, even empty.
  "preview_urls": true,
  "previews": {}
}
